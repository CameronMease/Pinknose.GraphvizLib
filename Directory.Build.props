<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Version>2.0.0</Version>
    <Authors>Cameron Mease</Authors>
    <Copyright>Copyright (c) 2022-2026 Cameron Mease</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CameronMease/Pinknose.GraphvizLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CameronMease/Pinknose.GraphvizLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>graphviz;dot;graph;diagram</PackageTags>
  </PropertyGroup>

</Project>
