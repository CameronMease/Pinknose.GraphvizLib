<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Description>Builds Graphviz DOT source from a .NET object model, including HTML-like labels. No dependencies; see Pinknose.GraphvizLib.Rendering to run Graphviz.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A raw PNG rather than a .resx Bitmap: a Bitmap resource needs System.Drawing, which is
      Windows-only on modern .NET and cannot be compiled into the netstandard target at all.
    -->
    <EmbeddedResource Include="Html\Icons\StatusWarning.png" LogicalName="Pinknose.GraphvizLib.Html.Icons.StatusWarning.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinknose.GraphvizLib.Rendering" />
    <InternalsVisibleTo Include="Pinknose.GraphvizLib.Tests" />
  </ItemGroup>

</Project>
